<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_bringup</name>
  <version>2.0.0</version>
  <description>
    Top-level bringup package for the ROBOFEST autonomous rocker-bogie rover.
    Contains launch files, global configuration, and parameter files for all subsystems.
  </description>
  <maintainer email="team@robofest.local">Rover Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rover_sensors</exec_depend>
  <exec_depend>rover_perception</exec_depend>
  <exec_depend>rover_localization</exec_depend>
  <exec_depend>rover_slam</exec_depend>
  <exec_depend>rover_navigation</exec_depend>
  <exec_depend>rover_control</exec_depend>
  <exec_depend>rover_behaviors</exec_depend>
  <exec_depend>rover_safety</exec_depend>
  <exec_depend>rover_description</exec_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version="1.0"?>
<!--
  rover.urdf.xacro
  ================
  URDF model for the ROBOFEST autonomous rocker-bogie rover.

  Status: PLANNED — all dimensions, masses, and inertias are PLACEHOLDER values.
          Must be measured from the physical rover before simulation is valid.

  Coordinate frame convention (REP-103):
    x = forward
    y = left
    z = up

  Links:
    base_link          — chassis body (origin at geometric centre)
    lidar_link         — LiDAR mounting point
    camera_link        — Camera mounting point
    imu_link           — IMU mounting point
    tof_front_left_link
    tof_front_center_link
    tof_front_right_link
    ultrasonic_front_link
    ultrasonic_rear_link
    wheel_*_link       — 6 wheel links (TBD)

  All xyz/rpy offsets are PLACEHOLDER — replace with actual measurements.
-->
<robot name="robofest_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- =========================================================
       PROPERTIES — TBD: measure all values from physical rover
       ========================================================= -->
  <xacro:property name="chassis_length" value="0.50"/>  <!-- TBD m -->
  <xacro:property name="chassis_width"  value="0.40"/>  <!-- TBD m -->
  <xacro:property name="chassis_height" value="0.12"/>  <!-- TBD m -->
  <xacro:property name="chassis_mass"   value="5.0"/>   <!-- TBD kg -->

  <xacro:property name="wheel_radius"   value="0.05"/>  <!-- TBD m -->
  <xacro:property name="wheel_width"    value="0.04"/>  <!-- TBD m -->
  <xacro:property name="wheel_mass"     value="0.3"/>   <!-- TBD kg -->

  <!-- =========================================================
       INERTIA MACROS
       ========================================================= -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12}" iyz="0"
             izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
             iyy="${m*(3*r*r+h*h)/12}" iyz="0"
             izz="${m*r*r/2}"/>
  </xacro:macro>

  <!-- =========================================================
       BASE LINK (Chassis)
       ========================================================= -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia m="${chassis_mass}"
                         x="${chassis_length}"
                         y="${chassis_width}"
                         z="${chassis_height}"/>
    </inertial>
  </link>

  <!-- =========================================================
       LIDAR LINK
       TBD: measure actual xyz offset from base_link centre
       ========================================================= -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <xacro:cylinder_inertia m="0.2" r="0.04" h="0.05"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <!-- TBD: replace with actual measured offsets -->
    <origin xyz="0.0 0.0 0.10" rpy="0 0 0"/>
  </joint>

  <!-- =========================================================
       CAMERA LINK — TBD: measure offset
       ========================================================= -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.09 0.03"/></geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <xacro:box_inertia m="0.05" x="0.03" y="0.09" z="0.03"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="0.20 0.0 0.05" rpy="0 0 0"/>  <!-- TBD -->
  </joint>

  <!-- =========================================================
       IMU LINK — TBD: must match physical IMU location exactly
       ========================================================= -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>  <!-- TBD: mount position -->
  </joint>

  <!-- =========================================================
       TOF SENSOR LINKS
       TBD: measure horizontal spacing and forward offset
       ========================================================= -->
  <xacro:macro name="tof_link" params="name x y z pitch">
    <link name="${name}_link">
      <visual>
        <geometry><box size="0.02 0.02 0.01"/></geometry>
        <material name="green"><color rgba="0 0.8 0 1"/></material>
      </visual>
      <inertial>
        <mass value="0.005"/>
        <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 ${pitch} 0"/>
    </joint>
  </xacro:macro>

  <!-- TBD: all xyz values are placeholder offsets -->
  <xacro:tof_link name="tof_front_left"   x="0.22" y=" 0.10" z="-0.02" pitch="0.2"/>
  <xacro:tof_link name="tof_front_center" x="0.23" y=" 0.00" z="-0.02" pitch="0.2"/>
  <xacro:tof_link name="tof_front_right"  x="0.22" y="-0.10" z="-0.02" pitch="0.2"/>

  <!-- =========================================================
       ULTRASONIC LINKS — TBD
       ========================================================= -->
  <link name="ultrasonic_front_link"><inertial><mass value="0.01"/>
    <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
  </inertial></link>
  <joint name="ultrasonic_front_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="ultrasonic_front_link"/>
    <origin xyz="0.25 0.0 0.0" rpy="0 0 0"/>  <!-- TBD -->
  </joint>

  <link name="ultrasonic_rear_link"><inertial><mass value="0.01"/>
    <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
  </inertial></link>
  <joint name="ultrasonic_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="ultrasonic_rear_link"/>
    <origin xyz="-0.25 0.0 0.0" rpy="0 0 3.14"/>  <!-- TBD -->
  </joint>

  <!-- =========================================================
       NOTE: Wheel links and rocker-bogie joints are TBD.
       Adding a full rocker-bogie kinematic chain to URDF
       requires accurate physical measurements and is outside
       the current scope. For initial simulation, a simplified
       4-wheel fixed-axle model may be used.
       ========================================================= -->

</robot>
